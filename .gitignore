# Runtime artifacts (per-run outputs)
_workspace/
_workspace_prev/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*~

# Env / secrets
.env
.env.local
.env.*.local

# Logs
*.log

# Python
__pycache__/
*.pyc

# Local Claude Code state is ignored, but the project-level loader symlinks
# (.claude/skills/*, .claude/agents) are committed so /humanize loads in
# every session opened on this repo, including claude.ai/code cloud sessions.
.claude/*
!.claude/skills/
!.claude/agents
